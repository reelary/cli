{
  "name": "reelary",
  "version": "0.1.1",
  "mcpName": "io.github.reelary/cli",
  "description": "Search your own footage by meaning and cut it into a video from Claude, Cursor, Codex and other AI agents. Installs Reelary (100% local) and its MCP server.",
  "homepage": "https://reelary.app/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelary/cli.git"
  },
  "bugs": "https://github.com/reelary/cli/issues",
  "type": "module",
  "bin": {
    "reelary": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "video",
    "footage",
    "b-roll",
    "rough-cut",
    "fcpxml",
    "media-library",
    "semantic-search",
    "claude",
    "agent-skills"
  ],
  "homepage": "https://reelary.app",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  }
}
